@startuml use_case_view

left to right direction
skinparam shadowing false

actor User

rectangle "Distributed VM Management System" {

    usecase "View Servers" as UC1
    usecase "View Virtual Machines" as UC2
    usecase "Start VM" as UC3
    usecase "Stop VM" as UC4
    usecase "Restart VM" as UC5
    usecase "Refresh Dashboard" as UC6
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

@enduml