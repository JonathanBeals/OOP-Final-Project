@startuml development_view

package "app" {
    component "server.py" as ServerFile
    component "virtual_machine.py" as VMFile
}

package "tests" {
    component "test_virtual_machine.py" as VMTests
}

component "Dockerfile" as Docker
component "Makefile" as Make

ServerFile --> VMFile : imports
VMTests --> VMFile : tests

Docker --> ServerFile : runs
Docker --> VMFile : runs

Make --> VMTests : runs tests

@enduml