#!/usr/bin/env bash

current_branch=$(git branch --show-current)

if [[ "$current_branch" != "main" ]]; then
    exit 0
fi

echo "Running pre-push checks on main..."

docker exec oop-final sh -c \
    'flake8 app tests && mypy app && pytest -q tests/'

if [[ $? -ne 0 ]]; then
    echo "Checks failed! Push cancelled."
    exit 1
fi

echo "All checks passed!"
exit 0